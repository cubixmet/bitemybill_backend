# BiteMyBills API — production template
# Copy to .env (or inject via your host/secrets manager). Never commit real values.

DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.bitemybills.tech,bitemybills.tech
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.bitemybills.tech,https://admin.bitemybills.tech,https://www.bitemybills.tech,https://bitemybills.tech

DATABASE_URL=postgres://USER:PASSWORD@DB_HOST:5432/bitemybills
REDIS_URL=redis://REDIS_HOST:6379/0

CORS_ALLOWED_ORIGINS=https://app.bitemybills.tech,https://admin.bitemybills.tech,https://www.bitemybills.tech,https://bitemybills.tech
# Storefront PWAs: {slug}-app.bitemybills.tech
CORS_ALLOWED_ORIGIN_REGEXES=^https://[\\w-]+-app\\.bitemybills\\.tech$

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

FRONTEND_RESTAURANT_URL=https://app.bitemybills.tech
FRONTEND_CUSTOMER_URL=https://bitemybills.tech
FRONTEND_ADMIN_URL=https://admin.bitemybills.tech
FRONTEND_BUILDER_URL=https://www.bitemybills.tech

STOREFRONT_BASE_DOMAIN=bitemybills.tech
STOREFRONT_SUBDOMAIN_SUFFIX=-app
STOREFRONT_PUBLIC_SCHEME=https

RAZORPAY_KEY_ID=REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=BiteMyBills <noreply@bitemybills.tech>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_ME
EMAIL_HOST_PASSWORD=REPLACE_ME
EMAIL_USE_TLS=true

# HTTPS / proxy (set when behind TLS terminator)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
