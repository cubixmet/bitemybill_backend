# BiteMyBills API — local development
# Copy to .env and adjust. Never commit .env.

DJANGO_SECRET_KEY=dev-bitemybills-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

DATABASE_URL=postgres://cubixmet@localhost:5432/bitemybill
REDIS_URL=redis://127.0.0.1:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:8080
CORS_ALLOWED_ORIGIN_REGEXES=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Public app URLs (emails, redirects, docs)
FRONTEND_RESTAURANT_URL=http://localhost:5173
FRONTEND_CUSTOMER_URL=http://localhost:5174
FRONTEND_ADMIN_URL=http://localhost:5175
FRONTEND_BUILDER_URL=http://localhost:5176

# Storefront PWA: {slug}-app.bitemybills.tech
STOREFRONT_BASE_DOMAIN=bitemybills.tech
STOREFRONT_SUBDOMAIN_SUFFIX=-app
STOREFRONT_PUBLIC_SCHEME=http

# Payments (leave blank locally unless testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email — console backend locally; set SMTP for real delivery
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BiteMyBills <noreply@bitemybills.tech>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
